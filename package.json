{
  "name": "sisferias",
  "private": true,
  "version": "3.0.4",
  "description": "SISFERIAS - sistema de planejamento e controle de férias para rede interna",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server/start.js",
    "build": "vite build",
    "dev": "vite",
    "dev:server": "node --watch server/start.js",
    "preview": "vite build && node server/start.js",
    "backup": "node server/start.js backup",
    "admin": "node server/start.js admin",
    "pacote": "node scripts/pacote.js",
    "servico": "node scripts/servico.js",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:e2e": "node tests/e2e/run.mjs",
    "typecheck": "tsc --noEmit",
    "https": "node scripts/https.js",
    "restaurar": "node server/start.js restaurar",
    "banco": "node server/start.js banco",
    "dados-ficticios": "node server/start.js dados-ficticios"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "node-forge": "^1.4.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "axe-core": "^4.10.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "postcss": "^8.5.30",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "write-excel-file": "^4.1.1"
  },
  "optionalDependencies": {
    "@embedded-postgres/darwin-arm64": "^17.10.0-beta.17",
    "@embedded-postgres/darwin-x64": "^17.10.0-beta.17",
    "@embedded-postgres/linux-arm64": "^17.10.0-beta.17",
    "@embedded-postgres/linux-x64": "^17.10.0-beta.17",
    "@embedded-postgres/windows-x64": "^17.10.0-beta.17"
